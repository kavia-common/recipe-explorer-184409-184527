# Example environment variables for recipe_frontend (Vite)
# Copy to .env and adjust for your environment.

# Development server port (vite.config.js uses VITE_PORT || PORT || 3000)
VITE_PORT=3001

# App environment
VITE_NODE_ENV=development

# Feature flags and options
VITE_ENABLE_SOURCE_MAPS=true
VITE_TRUST_PROXY=true
VITE_LOG_LEVEL=info
VITE_HEALTHCHECK_PATH=/health
VITE_FEATURE_FLAGS={}
VITE_EXPERIMENTS_ENABLED=false

# API endpoints
VITE_API_BASE=http://localhost:8080
VITE_BACKEND_URL=http://localhost:8080
VITE_FRONTEND_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:8080
