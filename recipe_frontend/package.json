{
  "name": "recipe_frontend",
  "private": true,
  "version": "0.0.1",
  "description": "Recipe Explorer frontend built with LightningJS (Blits)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite dev --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 3000 --strictPort",
    "lint": "eslint '**/*.js'",
    "lint:fix": "eslint '**/*.js' --fix"
  },
  "dependencies": {
    "@lightningjs/blits": "^1.41.0"
  },
  "devDependencies": {
    "vite": "^5.4.8",
    "@eslint/eslintrc": "3.1.0",
    "@eslint/js": "9.11.1",
    "eslint": "9.11.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "globals": "15.9.0",
    "lint-staged": "15.2.10",
    "prettier": "3.3.3"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ]
  }
}
